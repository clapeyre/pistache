# Point these at your own Bifrost gateway. Keep the /v1 suffix.
BIFROST_BASE_URL=https://gateway.example.com/v1
BIFROST_API_KEY=
BIFROST_MODEL=pistache-chat
SPEECH_BASE_URL=https://gateway.example.com/v1
STT_MODEL=openrouter/openai/gpt-transcribe
TTS_MODEL=openrouter/pistache-tts
TTS_VOICE=ff_siwis
# Use ./local/context for your own profile (ignored by Git).
CONTEXT_DIR=./examples/context
# For editing: copy examples/context into local/context, set CONTEXT_DIR there,
# then enable these two settings. Keep the checked-in examples read-only.
CONTEXT_EDITABLE=false
CONTEXT_MOUNT_MODE=ro
# Parent journal: kept locally, with no audio. Old entries expire automatically.
PARENTS_RETENTION_DAYS=30
PARENTS_MAX_TURNS=1000
